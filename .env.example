# คัดลอกเป็น .env แล้วใส่ค่าจริง — ไฟล์ .env ห้ามขึ้น git เด็ดขาด
# service key มีสิทธิ์ข้าม RLS ทั้งหมด ถ้าหลุดต้องถือว่าใช้ไม่ได้แล้วและต้องออกใหม่ทันที
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ใช้เฉพาะสาขาที่อ่านจากฐาน ZKBioTime ([source] type = biotime) และเครื่องนั้นตั้งให้ต้องใช้รหัสผ่าน
# ปกติเว้นว่างไว้ได้ เพราะ ZKBioTime ยอมให้ต่อจากในเครื่องโดยไม่ต้องใส่รหัสผ่าน
BIOTIME_PASSWORD=
